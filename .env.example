# Shopify Storefront API (public, read-only token — safe in the browser).
# Shopify admin → Settings → Apps → Develop apps → create app → Storefront API scopes:
#   unauthenticated_read_product_listings, unauthenticated_read_product_inventory,
#   unauthenticated_write_checkouts, unauthenticated_read_checkouts
PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
