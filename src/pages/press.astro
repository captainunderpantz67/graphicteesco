---
// Press kit (Sam go 2026-11-18, docs/pipeline/1051). Facts only: nothing here that is not already on /about/ or in site.ts.
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { site } from '../data/site';
import { breadcrumbs } from '../lib/schema';
import { getAllProducts, shopifyConnected } from '../lib/shopify';

const picks = [
  'mens-gym-sisyphus-had-bad-programming-graphic-tee',
  'womens-pilates-just-two-more-she-lied-graphic-tee',
  'mens-hunting-todays-special-tag-soup-hoodie',
  'womens-cat-oops-anyway-cropped-hoodie',
  'unisex-golf-sorry-about-your-windshield-hoodie',
  'mens-cat-dad-cant-cats-on-me-graphic-tee',
];
const all = shopifyConnected ? (await getAllProducts()).filter((p) => !p.sample) : [];
const byHandle = new Map(all.map((p) => [p.handle, p]));
const products = picks.map((h) => byHandle.get(h)).filter((p) => p !== undefined);
const threshold = site.facts.freeShippingThreshold;
const photoSlot = false; // flip to true when Sam sends a photo of himself and his brother (public/press/sam-and-brother.jpg)
---
<Base title={`Press kit | ${site.name}`}
  description={`Press kit for ${site.name}: the founder story, fast facts, contact and product images for writers and gift-guide editors.`}
  schema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Press', path: '/press/' }])]}>
  <section class="grain border-b border-[var(--color-line)]">
    <div class="container-x py-14 max-w-3xl">
      <p class="eyebrow">Press kit</p>
      <h1 class="display text-6xl md:text-7xl mt-2">{site.name} press kit</h1>
      <p class="mt-5 text-lg text-[var(--color-ink-2)]">Everything a writer or gift-guide editor needs about {site.name}: the story, the facts, the people and the products. Questions or interview requests: <a class="underline font-semibold" href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>

  <section class="container-x mt-12 grid md:grid-cols-[2fr_1fr] gap-12">
    <div class="prose-copy">
      <h2>The story</h2>
      <p>Sam grew up as a millennial kid who lived in funny graphic tees. About ten years ago he tried to start his own shirt shop, and it stalled. It lit a fire: he went on to learn digital marketing and became a marketing strategist.</p>
      <p>Now he's back to finish what he started, this time with his little brother drawing the designs. {site.name} is one home for funny shirts about the things people actually do. <a href="/about/">Read the full story on our About page.</a></p>

      <h2>The founder</h2>
      <p><strong>Sam King</strong>, founder and marketing strategist. He runs the shop and the marketing. His little brother draws the designs.</p>
      {photoSlot && <p><img src="/press/sam-and-brother.jpg" alt={`The two brothers behind ${site.name}`} width="900" height="600" loading="lazy" /></p>}

      <h2>Fast facts</h2>
      <ul class="list-disc pl-5 grid gap-2 text-[var(--color-ink-2)]">
        <li>Every shirt and hoodie is printed to order in the US by our print partner, then shipped to the customer.</li>
        {threshold && <li>Free US shipping on orders of ${threshold} or more.</li>}
        <li>One free size exchange within 30 days of delivery.</li>
        <li>Original art only: no licensed characters, team logos or stock graphics.</li>
        <li>A new collection every month, timed to the season.</li>
      </ul>

      <h2>Contact</h2>
      <p>Press, gift guides and interviews: <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
    <aside class="self-start border border-[var(--color-line)] p-6">
      <p class="eyebrow">Quick links</p>
      <ul class="mt-3 grid gap-2">
        <li><a href="/about/" class="font-semibold hover:text-[var(--color-rust)]">About us →</a></li>
        <li><a href="/gifts/" class="font-semibold hover:text-[var(--color-rust)]">Gift guides →</a></li>
        <li><a href="/shipping-returns/" class="font-semibold hover:text-[var(--color-rust)]">Shipping &amp; returns →</a></li>
      </ul>
    </aside>
  </section>

  {products.length > 0 && (
    <section class="container-x mt-14 mb-16">
      <h2 class="display text-4xl">A few of our favorites</h2>
      <div class="mt-6 grid grid-cols-2 md:grid-cols-3 gap-4">
        {products.map((p, i) => <ProductCard product={p} eager={i < 2} />)}
      </div>
    </section>
  )}
</Base>
