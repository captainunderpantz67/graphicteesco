---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`Shipping & Returns | ${site.name}`} description="How shipping works for printed-to-order graphic tees, and our 30-day reprint-or-refund promise for misprinted or damaged items." noindex={!site.facts.returnsPolicy}>
  <section class="container-x pt-10 max-w-3xl prose-copy">
    <h1 class="display text-6xl">Shipping &amp; Returns</h1>
    <p>Every item is printed after you order it, then shipped. US shipping is free on orders of $45 or more (that is two tees, or a crewneck and a tee); under $45, US shipping is a flat $4.95 for tees. Delivery estimates are shown at checkout.</p>
    {site.facts.productionDays && <p>Production time: {site.facts.productionDays}.</p>}
    {site.facts.returnsPolicy ? <p>{site.facts.returnsPolicy}</p> : <p><!-- TODO(Sam): returns policy (match Shopify + Printful policy) --></p>}
  </section>
</Base>
