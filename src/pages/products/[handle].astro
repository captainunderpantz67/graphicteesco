---
import Base from '../../layouts/Base.astro';
import { getAllProducts, formatPrice, type Product } from '../../lib/shopify';
import Faq from '../../components/Faq.astro';
import { productSchema, breadcrumbs, faqPage } from '../../lib/schema';
import { resolveFaqs } from '../../data/site';
import { all, pathFor } from '../../data/collections';

export async function getStaticPaths() {
  const products = await getAllProducts();
  // Twin = same design name on the other blank ("Bass at Dawn Tee" <-> "Bass at Dawn Hoodie").
  const base = (t: string) => t.replace(/\s+(tee|t-shirt|shirt|hoodie)$/i, '').trim().toLowerCase();
  return products.map((p) => ({
    params: { handle: p.handle },
    props: { product: p, twin: products.find((o) => o.handle !== p.handle && base(o.title) === base(p.title)) },
  }));
}
const { product: p, twin } = Astro.props as { product: Product; twin?: Product };
const sizes = p.variants;
const isHoodie = /hood/i.test(p.productType) || /hood/i.test(p.title);
const item = isHoodie ? 'hoodie' : 'graphic tee';
// Product FAQs: long-tail care/fit/shipping questions. Fact-dependent ones hide until confirmed.
const faqs = resolveFaqs([
  { q: `Is the ${p.title} design original?`, a: 'Yes. It was drawn for this shop — no licensed characters or stock art.' },
  { q: `How do I wash this ${item}?`, a: 'Turn it inside out, wash cold on gentle, skip bleach and fabric softener, and hang dry or tumble dry low. Never iron directly on the print.' },
  { q: `How is this ${item} made?`, a: 'It is printed after you order it, then shipped to you.' },
  { q: 'How long until it ships?', a: (f) => `Printing takes ${f.productionDays}, then it ships. Delivery estimates show at checkout.`, needs: 'productionDays' },
  { q: 'What sizes does it come in?', a: (f) => `Sizes run ${f.sizeRange}.`, needs: 'sizeRange' },
  { q: `What is this ${item} made of?`, a: (f) => `${isHoodie ? f.hoodieBlank : f.teeBlank}.`, needs: isHoodie ? 'hoodieBlank' : 'teeBlank' },
  { q: 'Can I return it?', a: (f) => f.returnsPolicy!, needs: 'returnsPolicy' },
]);
// Collections this product belongs to (by Shopify collection handles) — internal links back up.
const parents = all.filter((c) => p.collections?.includes(c.shopifyHandle));
---
<Base title={p.seo?.title || `${p.title} — ${isHoodie ? 'Graphic Hoodie' : 'Graphic Tee'}`} description={p.seo?.description || p.description.slice(0, 155)}
  image={p.featuredImage?.url}
  schema={[productSchema(p), faqPage(faqs), breadcrumbs([{ name: 'Home', path: '/' }, ...(parents[0] ? [{ name: parents[0].h1, path: pathFor(parents[0]) }] : []), { name: p.title, path: `/products/${p.handle}/` }])]}>
  <section class="container-x pt-8 grid md:grid-cols-2 gap-10">
    <div class="grid gap-3">
      {p.images.length > 0
        ? p.images.map((img, i) => <img data-main={i === 0 ? '' : undefined} src={`${img.url}&width=1000`} alt={img.altText ?? p.title} width="1000" height="1250"
            loading={i === 0 ? 'eager' : 'lazy'} class="w-full bg-[var(--color-paper-2)]" />)
        : <div class="aspect-[4/5] bg-[var(--color-paper-2)] grain"></div>}
    </div>
    <div class="md:sticky md:top-24 self-start">
      <p class="eyebrow">{isHoodie ? 'Graphic hoodie' : 'Graphic tee'}</p>
      <h1 class="display text-5xl mt-2">{p.title}</h1>
      <p class="mt-3 text-xl" data-price>{formatPrice(p.priceRange.minVariantPrice)}</p>
      <form data-add-to-cart class="mt-6 grid gap-5" data-variants={JSON.stringify(p.variants.map((v) => ({ id: v.id, ok: v.availableForSale, price: formatPrice(v.price), img: v.image?.url ?? null, opts: Object.fromEntries(v.selectedOptions.map((o) => [o.name, o.value])) })))}>
        <input type="hidden" name="variant" value={p.variants.find((v) => v.availableForSale)?.id ?? ''} />
        {p.options.filter((o) => o.values.length > 1 || p.options.length === 1).map((o) => (
          <fieldset data-option={o.name}>
            <legend class="text-sm font-bold uppercase tracking-[.12em] mb-2">{o.name}: <span data-chosen class="font-normal normal-case tracking-normal">{o.values[0]}</span></legend>
            <div class="flex flex-wrap gap-2">
              {o.values.map((val, i) => (
                <label class="cursor-pointer">
                  <input type="radio" name={`opt-${o.name}`} value={val} class="peer sr-only" checked={i === 0} />
                  <span class="block border-2 border-[var(--color-ink)] rounded-full px-4 py-1.5 text-sm font-semibold peer-checked:bg-[var(--color-ink)] peer-checked:text-[var(--color-cream)] peer-focus-visible:outline peer-focus-visible:outline-3 peer-focus-visible:outline-[var(--color-mustard)] peer-disabled:opacity-35 peer-disabled:line-through">{val}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
        <p class="text-sm text-[var(--color-ink-2)]" data-stock></p>
        <button type="submit" class="btn btn-rust w-full">Add to cart</button>
      </form>
      {twin && (
        <a href={`/products/${twin.handle}/`} class="mt-4 inline-flex items-center gap-2 font-bold underline decoration-[var(--color-rust)] decoration-2 underline-offset-4">
          Also on a {/hood/i.test(twin.productType) || /hood/i.test(twin.title) ? 'hoodie' : 'tee'}: {twin.title} →
        </a>
      )}
      <div class="prose-copy mt-8" set:html={p.descriptionHtml} />
      {parents.length > 0 && <p class="mt-6 text-sm">In: {parents.map((c, i) => <>{i > 0 && ', '}<a href={pathFor(c)} class="underline">{c.h1}</a></>)}</p>}
      <div class="mt-8"><Faq faqs={faqs} /></div>
    </div>
  </section>
<script>
  const form = document.querySelector<HTMLFormElement>('form[data-add-to-cart][data-variants]');
  if (form) {
    const variants: { id: string; ok: boolean; price: string; img: string | null; opts: Record<string, string> }[] = JSON.parse(form.dataset.variants!);
    const hidden = form.querySelector<HTMLInputElement>('input[name=variant]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const main = document.querySelector<HTMLImageElement>('img[data-main]');
    const priceEl = document.querySelector('[data-price]');
    const stock = form.querySelector('[data-stock]')!;
    const sets = [...form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-option]')];
    const chosen = () => Object.fromEntries(sets.map((f) => [f.dataset.option!, (f.querySelector<HTMLInputElement>('input:checked')?.value) ?? '']));
    const update = () => {
      const c = chosen();
      sets.forEach((f) => { f.querySelector('[data-chosen]')!.textContent = c[f.dataset.option!]; });
      const v = variants.find((x) => Object.entries(c).every(([k, val]) => x.opts[k] === val));
      hidden.value = v?.ok ? v.id : '';
      btn.disabled = !v?.ok;
      btn.textContent = v?.ok ? 'Add to cart' : 'Sold out';
      stock.textContent = '';
      if (v && priceEl) priceEl.textContent = v.price;
      if (v?.img && main) main.src = v.img + (v.img.includes('?') ? '&' : '?') + 'width=1000';
    };
    form.addEventListener('change', update);
    update();
  }
</script>
</Base>
