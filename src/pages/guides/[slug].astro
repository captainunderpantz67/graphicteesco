---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { guides, type Guide, type Pick, type PickGroup } from '../../data/guides';
import { article, faqPage, howTo, breadcrumbs, itemListOfProducts } from '../../lib/schema';
import { linkableSlugs, filterHrefs } from '../../lib/linkable';
import { getAllProducts, shopifyConnected, type Product } from '../../lib/shopify';

type ResolvedPick = Pick & { teeProduct?: Product; crewProduct?: Product };
type ResolvedGroup = Omit<PickGroup, 'items'> & { items: ResolvedPick[] };

export async function getStaticPaths() {
  // Roundup guides list only products the store is selling right now (Storefront returns ACTIVE, published products).
  const needProducts = shopifyConnected && guides.some((g) => g.picks?.length);
  const byHandle = new Map((needProducts ? await getAllProducts() : []).filter((p) => !p.sample).map((p) => [p.handle, p]));
  const resolve = (groups: PickGroup[] = []): ResolvedGroup[] =>
    groups
      .map((grp) => ({
        ...grp,
        items: grp.items
          .filter((it) => !shopifyConnected || byHandle.has(it.tee))
          .map((it) => ({
            ...it,
            teeProduct: byHandle.get(it.tee),
            crewProduct: it.crewneck ? byHandle.get(it.crewneck) : undefined,
            crewneck: it.crewneck && (!shopifyConnected || byHandle.has(it.crewneck)) ? it.crewneck : undefined,
          })),
        links: grp.links?.filter((l) => !l.href.startsWith('/products/') || !shopifyConnected || byHandle.has(l.href.split('/')[2])),
      }))
      .filter((grp) => grp.items.length > 0);
  return guides.map((g) => ({ params: { slug: g.slug }, props: { guide: g, picks: resolve(g.picks) } }));
}
const { guide: g, picks } = Astro.props as { guide: Guide; picks: ResolvedGroup[] };
const path = `/guides/${g.slug}/`;
// Only link to collections that have products and are indexable.
const live = await linkableSlugs();
const listed = picks.flatMap((grp) => grp.items.flatMap((it) => [
  ...(it.teeProduct ? [{ name: it.teeProduct.title, handle: it.teeProduct.handle }] : []),
  ...(it.crewProduct ? [{ name: it.crewProduct.title, handle: it.crewProduct.handle }] : []),
]));
const schema = [
  article({ title: g.h1, description: g.description, path, date: g.date }),
  faqPage(g.faqs),
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Guides', path: '/guides/' }, { name: g.h1, path }]),
  ...(g.howTo ? [howTo(g.howTo.name, g.answer, g.howTo.steps)] : []),
  ...(listed.length ? [itemListOfProducts(g.h1, listed)] : []),
];
const linkRow = (links?: { href: string; text: string }[]) => (links ? filterHrefs(links, live) : []);
---
<Base title={g.title} description={g.description} schema={schema}>
  <article class="container-x pt-10 max-w-3xl prose-copy">
    <p class="eyebrow">Graphic tee guide</p>
    <h1 class="display text-5xl md:text-6xl mt-2">{g.h1}</h1>
    <p class="!text-lg !text-[var(--color-ink)] mt-4 border-l-4 border-[var(--color-rust)] pl-4">{g.answer}</p>
    {g.howTo && (
      <>
        <h2>{g.howTo.name}: step by step</h2>
        <ol class="list-decimal pl-5 grid gap-3 mt-3">
          {g.howTo.steps.map((s) => <li><strong>{s.name}.</strong> <span class="text-[var(--color-ink-2)]">{s.text}</span></li>)}
        </ol>
      </>
    )}
    {picks.map((grp) => (
      <>
        <h2>{grp.h2}</h2>
        {grp.body.map((b) => <p>{b}</p>)}
        {grp.items.map((it) => (
          <section class="mt-8">
            <h3 class="display text-2xl uppercase">“{it.slogan}”</h3>
            <p>{it.text}</p>
            {it.teeProduct ? (
              <div class="grid grid-cols-2 gap-4 mt-4 max-w-md">
                <ProductCard product={it.teeProduct} />
                {it.crewProduct && <ProductCard product={it.crewProduct} />}
              </div>
            ) : (
              <p class="flex flex-wrap gap-x-4">
                <a href={`/products/${it.tee}/`} class="font-semibold underline decoration-[var(--color-rust)] underline-offset-4">{it.slogan} tee →</a>
                {it.crewneck && <a href={`/products/${it.crewneck}/`} class="font-semibold underline decoration-[var(--color-rust)] underline-offset-4">{it.slogan} crewneck →</a>}
              </p>
            )}
          </section>
        ))}
        {linkRow(grp.links).length > 0 && <p class="flex flex-wrap gap-x-4 mt-6">{linkRow(grp.links).map((l) => <a href={l.href} class="font-semibold underline decoration-[var(--color-rust)] underline-offset-4">{l.text} →</a>)}</p>}
      </>
    ))}
    {g.sections.map((s) => (
      <>
        <h2>{s.h2}</h2>
        {s.body.map((b) => <p>{b}</p>)}
        {linkRow(s.links).length > 0 && <p class="flex flex-wrap gap-x-4">{linkRow(s.links).map((l) => <a href={l.href} class="font-semibold underline decoration-[var(--color-rust)] underline-offset-4">{l.text} →</a>)}</p>}
      </>
    ))}
    {g.faqs.length > 0 && (
      <section class="mt-12 border-t border-[var(--color-line)] pt-6">
        <p class="eyebrow">FAQ</p>
        {/* R8.7: every FAQ answer is in the HTML as h2 + p (paired with the FAQPage schema from the same array). */}
        {g.faqs.map((f) => (
          <>
            <h2 class="!text-xl !normal-case !mt-6">{f.q}</h2>
            <p class="!mt-2">{f.a}</p>
          </>
        ))}
      </section>
    )}
    <p class="mt-10"><a href="/" class="btn">Shop original graphic tees</a></p>
  </article>
</Base>
