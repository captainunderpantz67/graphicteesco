---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Configurator from '../../components/configurator/Configurator.astro';
import { customPages, type CustomPage } from '../../data/configurator/pages';
import { breadcrumbs, faqPage } from '../../lib/schema';
import { customProductSchema } from '../../lib/configurator/schema';
import { getCustomVariants } from '../../lib/configurator/storefront';
import { CUSTOM_PRICE } from '../../lib/configurator/pricing';
import { site } from '../../data/site';

export function getStaticPaths() {
  return customPages.map((p) => ({ params: { page: p.slug }, props: { page: p } }));
}
const { page: p } = Astro.props as { page: CustomPage };
const path = `/custom/${p.slug}/`;
// The Shopify product for this blank (SETUP.md). Until it exists the page works end to end except "Add to cart".
const variants = await getCustomVariants(p.example.blank);
const price = variants[0]?.price ?? CUSTOM_PRICE.tee.price;
const compareAt = variants[0] ? variants[0].compareAt : CUSTOM_PRICE.tee.compareAt;
const schema = [
  customProductSchema(p, price, compareAt, `${site.url}/og-default.png`),
  faqPage(p.faqs),
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Custom shirts', path: '/custom/custom-photo-shirt/' }, { name: p.h1, path }]),
];
---
<Base title={`${p.title} | ${site.name}`} description={p.description} schema={schema} noindex={!p.indexable}>
  <nav aria-label="Breadcrumb" class="container-x pt-5 text-xs text-[var(--color-ink-2)]">
    <a href="/" class="hover:underline">Home</a> / <span>Custom shirts</span>
  </nav>
  <section class="container-x pt-4 max-w-3xl">
    <p class="eyebrow">{p.eyebrow}</p>
    <h1 class="display text-[clamp(2.6rem,7vw,4.4rem)] mt-2">{p.h1}</h1>
    <p class="mt-4 text-lg text-[var(--color-ink-2)] leading-relaxed">{p.intro}</p>
  </section>

  <Configurator page={p} variants={variants} price={price} compareAt={compareAt} />

  <section class="container-x mt-16 grid md:grid-cols-[2fr_1fr] gap-12">
    <div class="prose-copy">
      {p.sections.map((s) => <><h2>{s.h2}</h2>{s.body.map((b) => <p>{b}</p>)}</>)}
      <Faq faqs={p.faqs} heading="Questions" />
    </div>
    <aside class="text-sm grid gap-4 content-start">
      <div class="rounded-2xl border-2 border-[var(--color-ink)] bg-[var(--color-cream)] p-5">
        <p class="eyebrow">What you get</p>
        <ul class="mt-3 grid gap-2 text-[var(--color-ink-2)]">
          <li>Bella+Canvas 3001 cotton tee, lightweight 4.2 oz</li>
          <li>Direct-to-garment print, front and back where the design has one</li>
          <li>Printed to order in the US, 2–5 business days, then shipped</li>
          <li>Free US shipping on orders of $45+</li>
          <li>Misprints reprinted or refunded within 30 days</li>
        </ul>
      </div>
      <div class="rounded-2xl border border-[var(--color-line)] p-5">
        <p class="eyebrow">Other custom shirts</p>
        <ul class="mt-3 grid gap-2">
          {customPages.filter((o) => o.slug !== p.slug).map((o) => <li><a href={`/custom/${o.slug}/`} class="font-semibold underline decoration-[var(--color-rust)] underline-offset-4">{o.h1} →</a></li>)}
        </ul>
      </div>
    </aside>
  </section>
</Base>
