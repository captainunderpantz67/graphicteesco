---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="container-x py-24 text-center">
    <h1 class="display text-7xl">Lost the trail.</h1>
    <p class="mt-4 text-[var(--color-ink-2)]">That page doesn't exist. Try the graphic tees instead.</p>
    <a href="/" class="btn mt-8">Back to the shop</a>
  </section>
</Base>
