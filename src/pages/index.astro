---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { site, resolveFaqs } from '../data/site';
import { tees, hoodies, pathFor, bySlug } from '../data/collections';
import { faqPage, itemListOfCollections } from '../lib/schema';
import { getAllProducts } from '../lib/shopify';
import { linkableSlugs, hoodiesHubLive } from '../lib/linkable';
import { daysUntil, featuredHoliday, homepageOrder, sellable } from '../lib/holidays';
import { coverFor as liveCover } from '../data/covers';

// Real product photos for cards: the main (model/lifestyle) mockup of the newest product in each collection.
const allProducts = (await getAllProducts()).filter((p) => !p.sample && p.images.length);
// Evergreen cards show only designs made to the current standard (Sam 2026-10-20: the old badge designs on these cards "are trash compared to the new ones").
import freshList from '../data/fresh-designs.json';
const fresh = new Set<string>(freshList as string[]);
const freshPhoto = (p: (typeof allProducts)[number]) => { const c = liveCover(p.handle); return c ? { url: c.src, altText: c.alt, local: true } : p.images[0]; };
const photoFor = (slug: string) => { const f = allProducts.find((p) => p.collections?.includes(slug) && fresh.has(p.handle)); return f ? freshPhoto(f) : allProducts.find((p) => p.collections?.includes(slug))?.images[0] ?? null; };
const photoOf = (handle: string, fallbackSlug: string) =>
  allProducts.find((p) => p.handle === handle)?.images[0] ?? photoFor(fallbackSlug);
const menPhoto = photoOf('mens-mechanic-no-i-cant-just-take-a-quick-look-graphic-tee', 'graphic-tees-for-men');
const womenPhoto = photoOf('womens-hiking-treat-me-like-wildlife-graphic-tee', 'graphic-tees-for-women');
const img = (u: string, w: number) => `${u}${u.includes('?') ? '&' : '?'}width=${w}`;

// Only linkable collections (products + indexable) get a card or link.
const live = await linkableSlugs();
const showHoodies = hoodiesHubLive();
// Only collections that actually have products get a card (an empty page is a dead end and won't be indexed).
const womens = tees.filter((c) => c.audience === 'women' && c.slug !== 'graphic-tees-for-women' && live.has(c.slug) && allProducts.some((p) => p.collections?.includes(c.shopifyHandle)));
const outdoors = ['fishing-t-shirts', 'hunting-t-shirts', 'western-graphic-tees', 'mens-gym-shirts', 'football-shirts', 'soccer-mom-shirts'].map((s) => bySlug(s)!).filter((c) => live.has(c.slug));
const styles = ['oversized-graphic-tees', 'vintage-graphic-tees', 'retro-graphic-tees', 'funny-graphic-tees', 'y2k-graphic-tees', 'anime-shirts', 'embroidered-sweatshirts'].map((s) => bySlug(s)!).filter((c) => live.has(c.slug));
// Holiday shelf: every live holiday tee collection, soonest holiday first.
const holidayTees = homepageOrder(tees.filter((c) => c.seasonal && live.has(c.slug)));
// Hero: the general page for each of the two nearest holidays (e.g. Christmas Shirts, Thanksgiving Shirts), the rest go in the drawer.
const heroSeasons = [...new Set(holidayTees.map((c) => c.seasonal))].slice(0, 2);
const heroPrimary = heroSeasons.map((sn) => holidayTees.find((c) => c.seasonal === sn && !c.audience && !/funny|sweat/.test(c.slug)) ?? holidayTees.find((c) => c.seasonal === sn)!);
const heroRest = holidayTees.filter((c) => !heroPrimary.includes(c));
// Cover photo per card: match the collection's audience (women's card → a women's tee)
// and never repeat a photo already used by an earlier card.
const usedCovers = new Set<string>();
// Hand-picked homepage photos (Sam 2026-10-19: the newest AI covers "look AI as heck"). The older, candid,
// natural-light covers go first; a card uses the first pick that belongs to its collection, else the old rule.
const CARD_PICKS = [
  'womens-christmas-vintage-santa-graphic-tee', 'womens-christmas-nutcracker-bow-graphic-tee', 'unisex-christmas-deer-camp-christmas-graphic-tee',
  'unisex-christmas-vintage-santa-crewneck-sweatshirt', 'unisex-christmas-deer-camp-christmas-crewneck-sweatshirt', 'unisex-christmas-christmas-tree-farm-crewneck-sweatshirt',
  'womens-christmas-christmas-cats-graphic-tee', 'womens-christmas-merry-bright-graphic-tee', 'womens-christmas-vintage-snowman-graphic-tee', 'womens-christmas-oh-deer-graphic-tee',
  'womens-thanksgiving-pumpkin-pie-graphic-tee', 'unisex-thanksgiving-turkey-trot-graphic-tee', 'unisex-thanksgiving-give-thanks-harvest-crewneck-sweatshirt',
  'womens-thanksgiving-friendsgiving-graphic-tee', 'unisex-thanksgiving-give-thanks-harvest-graphic-tee',
];
const coverFor = (c: (typeof tees)[number]) => {
  const wantSweatPick = /sweatshirt/.test(c.slug);
  const pick = CARD_PICKS.map((h) => allProducts.find((x) => x.handle === h)).find((x) => x && x.collections?.includes(c.shopifyHandle) && liveCover(x.handle) && !usedCovers.has(x.handle) && /sweatshirt/.test(x.handle) === wantSweatPick
    && (!c.audience || !x.handle.startsWith(c.audience === 'women' ? 'mens-' : 'womens-')));
  if (pick) { usedCovers.add(pick.handle); return liveCover(pick.handle); }
  // Newest first (higher Shopify id = newer) so cards show the current art style, not the old badge designs.
  // Shirt cards show a tee, sweatshirt cards show a crewneck (Sam, 2026-10-13).
  const wantSweat = /sweatshirt/.test(c.slug);
  const pool = allProducts.filter((x) => x.collections?.includes(c.shopifyHandle) && liveCover(x.handle) && !usedCovers.has(x.handle) && /sweatshirt/.test(x.handle) === wantSweat)
    .sort((a, b) => Number(b.id.split('/').pop()) - Number(a.id.split('/').pop()));
  const p = (c.audience ? pool.find((x) => x.handle.startsWith(c.audience === 'women' ? 'womens-' : 'mens-')) : undefined) ?? pool[0];
  if (!p) return null;
  usedCovers.add(p.handle);
  return liveCover(p.handle);
};
const productCount = (c: (typeof tees)[number]) => allProducts.filter((x) => x.collections?.includes(c.shopifyHandle)).length;
const featured = featuredHoliday();
const dropSeason = holidayTees.find((c) => c.seasonal !== featured)?.seasonal ?? featured;
const drop = tees.find((c) => c.seasonal === dropSeason && !c.audience) ?? tees.find((c) => c.seasonal === dropSeason)!;
const holidayCards = holidayTees.map((c) => ({ c, ph: coverFor(c) }));
// MAJOR SPOKES (Sam 2026-10-21, CRO: "6-8 major spokes here instead of all these niches, niches in a carousel under").
// Broad doors first (tees, hoodies, zips, camo, gifts…), then every niche in one swipe row. Titles keep the house tone.
const usedMajor = new Set<string>();
const photoIn = (handle: string, prefer?: RegExp) => {
  const pool = allProducts.filter((x) => x.collections?.includes(handle) && !usedMajor.has(x.handle));
  const pick = pool.find((x) => liveCover(x.handle) && (!prefer || prefer.test(x.handle)) && fresh.has(x.handle))
    ?? pool.find((x) => liveCover(x.handle) && (!prefer || prefer.test(x.handle))) ?? pool.find((x) => liveCover(x.handle));
  if (pick) { usedMajor.add(pick.handle); const cv = liveCover(pick.handle)!; return { src: cv.src, alt: cv.alt }; }
  const any = pool[0]; if (!any) return null; usedMajor.add(any.handle);
  return { src: img(any.images[0].url, 600), alt: any.images[0].altText || any.title };
};
const xmasDays = daysUntil('christmas');
const tgDays = daysUntil('thanksgiving');
const MAJOR = [
  { slug: 'christmas-shirts', href: '/christmas-shirts/', title: 'Christmas', line: 'Festive. Mildly sarcastic.', badge: xmasDays > 0 ? `${xmasDays} days` : null, prefer: /christmas/ },
  { slug: 'thanksgiving-shirts', href: '/thanksgiving-shirts/', title: 'Thanksgiving', line: 'Here for the pie. Leaving with leftovers.', badge: tgDays > 0 ? `${tgDays} days` : null, prefer: /thanksgiving/ },
  { slug: 'funny-graphic-tees', href: '/funny-graphic-tees/', title: 'Graphic Tees', line: 'One good joke per shirt.', prefer: /graphic-tee$/ },
  { slug: null, href: '/hoodies/', title: 'Hoodies', line: 'Same jokes. Warmer.', handle: 'graphic-hoodies-for-men', prefer: /hoodie$/ },
  { slug: 'zip-up-hoodies', href: '/hoodies/zip-up-hoodies/', title: 'Zip-Ups', line: "The joke's on the back.", prefer: /zip-hoodie$/ },
  { slug: 'camo-hoodies', href: '/hoodies/camo-hoodies/', title: 'Camo', line: 'Blend in. Stand out anyway.', prefer: /camo/ },
  { slug: null, href: '/gifts/', title: 'Gifts', line: 'Socks, mugs, ornaments, sweats.', gifts: true },
  { slug: 'group-shirts', href: '/group-shirts/', title: 'Matching Crew', line: 'Whole crew, one joke. 15% off 10+.' },
].filter((m) => !m.slug || live.has(m.slug)).filter((m) => m.href !== '/hoodies/' || showHoodies);
const majorCards = MAJOR.map((m) => ({ ...m, ph: m.gifts ? null : photoIn(m.handle ?? bySlug(m.slug!)!.shopifyHandle, m.prefer) }));
// Gifts card: a 3-up collage of real add-on product shots (ornament, socks, mug).
const giftShots = [/ornament$/i, /socks$/i, /mug$/i, /(sweatpants|joggers)$/i].map((rx) => allProducts.find((x) => rx.test(x.title.trim()))).filter(Boolean).map((x) => ({ src: img(x!.images[0].url, 300), alt: x!.title }));
// NICHES: every other live collection, holidays first, then by search volume.
const majorSlugs = new Set(MAJOR.map((m) => m.slug).filter(Boolean));
const niches = [...homepageOrder([...tees, ...hoodies].filter((c) => c.seasonal && live.has(c.slug) && !majorSlugs.has(c.slug))),
  ...[...tees, ...hoodies].filter((c) => !c.seasonal && live.has(c.slug) && !majorSlugs.has(c.slug)).sort((a, b) => b.volume - a.volume)]
  .map((c) => ({ c, ph: photoIn(c.shopifyHandle), n: productCount(c) })).filter((x) => x.ph);
// One hero: holiday version while a holiday collection is still deliverable (homepageOrder handles lead time).
const inSeason = holidayTees.length > 0;
// Hero (Sam 2026-10-21): evergreen and in the store's voice, no holiday art or green; holidays live in the Start-here cards.
const heroHoliday = false;
const dropCover = dropSeason === 'halloween' ? null : coverFor(drop);
const dropTwin = drop.twin ? bySlug(drop.twin) : undefined;

// Answer blocks: questions from Google autocomplete for "graphic tees" (2026-10-02).
// Each answers in the first sentence (snippet / AI-overview extraction), then links deeper.
const answers = [
  {
    q: 'What are graphic tees?',
    a: 'Graphic tees are T-shirts printed with artwork, text or both. They range from band and slogan tees to original illustrated designs like ours, which are organized by what people do — fishing, hunting, western, gym — rather than by trend.',
  },
  {
    q: 'Are graphic tees still in style in 2026?',
    a: 'Yes. "Graphic tees" averages about 301,000 US Google searches a month, and interest peaked in July 2026. The current looks are vintage-inspired prints, oversized and cropped fits, and western designs.',
    link: { href: '/guides/are-graphic-tees-in-style/', text: 'What’s in style for graphic tees' },
  },
  {
    q: 'How do you style a graphic tee?',
    a: 'Let the tee be the focal point and keep everything else simple: straight-leg jeans and sneakers for every day, a blazer or denim jacket to dress it up, and a front tuck to add shape. The same rules work for men, women and every age.',
    link: { href: '/guides/how-to-style-graphic-tees/', text: 'How to style graphic tees' },
  },
  {
    q: 'How do you wash graphic tees without cracking or fading?',
    a: 'Turn the tee inside out, wash it cold on a gentle cycle, skip bleach and fabric softener, and hang it dry or tumble dry on low. Never iron directly on the print.',
    link: { href: '/guides/how-to-wash-graphic-tees/', text: 'Full graphic tee care guide' },
  },
  {
    q: 'Graphic tees vs plain tees — which should you buy?',
    a: 'Plain tees are layering basics; graphic tees carry the outfit on their own. Most closets need both. A graphic tee says something about what you’re into, which is why we build collections around hobbies.',
  },
  {
    q: 'Where can you buy original graphic tees online?',
    a: `${site.name} sells original graphic tees${site.facts.hoodiesLive ? ' and hoodies' : ''} online, printed to order, with a new collection every month. Shop by collection below or start with men's or women's graphic tees.`,
  },
];

const faqs = resolveFaqs([
  { q: 'Are your graphic tees original designs?', a: 'Yes. Every design is made for this shop — no licensed characters or resold stock art.' },
  { q: 'Do your graphic tee designs come on hoodies?', a: 'Yes. Most tee designs are also printed on hoodies, so you can wear the same art all year.', needs: 'hoodiesLive' },
  { q: 'How often do you release new graphic tees?', a: 'A new collection drops every month, timed to the season.' },
  { q: 'How are your graphic tees made?', a: 'Each one is printed after you order it, then shipped to you. Nothing sits in a warehouse.' },
  { q: 'How long does shipping take?', a: (f) => `Printing takes ${f.productionDays}, then your order ships. Delivery estimates show at checkout.`, needs: 'productionDays' },
  { q: 'What sizes do your graphic tees come in?', a: (f) => `Sizes run ${f.sizeRange}. Every product has a size chart.`, needs: 'sizeRange' },
]);

const icons: Record<string, string> = {
  'fishing-t-shirts': 'fish', 'hunting-t-shirts': 'antlers', 'western-graphic-tees': 'hat', 'mens-gym-shirts': 'barbell',
  'football-shirts': 'football', 'soccer-mom-shirts': 'star', 'country-graphic-tees': 'boot', 'cropped-graphic-tees': 'crop',
  'graphic-tees-for-women-over-40': 'sun', 'football-mom-shirts': 'football', 'baseball-mom-shirts': 'baseball',
  'nurse-shirts': 'nurse', 'christian-shirts': 'cross', 'oversized-graphic-tees': 'tee', 'vintage-graphic-tees': 'sun',
  'y2k-graphic-tees': 'bolt', 'anime-shirts': 'star', 'retro-graphic-tees': 'bolt', 'funny-graphic-tees': 'star', 'embroidered-sweatshirts': 'tee',
};
// Photo-real icon images (public/bubbles/<slug>.webp) when listed here; otherwise the line icon.
// Hand-made lifestyle photos for the women's collection cards (public/cards/<slug>.webp): each one shot in the shirt's own world.
const cardImgs: Record<string, { src: string; alt: string }> = {
  'football-mom-shirts': { src: '/cards/football-mom-shirts.webp', alt: 'Mom sitting in the home bleachers at a Friday night football game in a navy Football Mom graphic tee' },
  'baseball-mom-shirts': { src: '/cards/baseball-mom-shirts.webp', alt: 'Mom on the ballpark bleachers at golden hour in a navy Baseball Mom graphic tee' },
  'soccer-mom-shirts': { src: '/cards/soccer-mom-shirts.webp', alt: 'Mom on the youth soccer sideline in a navy Soccer Mom graphic tee' },
  'nurse-shirts': { src: '/cards/nurse-shirts.webp', alt: 'Nurse with coffee outside the hospital after a night shift in a black Nurse Life graphic tee' },
  'christian-shirts': { src: '/cards/christian-shirts.webp', alt: 'Woman outside a white country church on Sunday morning in a Grace Wins Christian graphic tee' },
  'cropped-graphic-tees': { src: '/cards/cropped-graphic-tees.webp', alt: 'Young woman in a wildflower meadow wearing a black Wildflower Club cropped graphic tee' },
};
const bubbleImgs = new Set<string>(['fishing-t-shirts', 'hunting-t-shirts', 'western-graphic-tees', 'country-graphic-tees', 'mens-gym-shirts', 'football-mom-shirts', 'christian-shirts', 'nurse-shirts']);
const bubbles = ['fishing-t-shirts', 'hunting-t-shirts', 'western-graphic-tees', 'country-graphic-tees', 'mens-gym-shirts', 'football-mom-shirts', 'christian-shirts', 'nurse-shirts'].map((s) => bySlug(s)!);
// Poster-card palettes for the women's row (bg, ink, accent)
const tones = [
  ['var(--color-rust)', 'var(--color-cream)', 'var(--color-mustard)'],
  ['var(--color-navy)', 'var(--color-cream)', 'var(--color-rust)'],
  ['var(--color-mustard)', 'var(--color-ink)', 'var(--color-rust)'],
  ['var(--color-moss)', 'var(--color-cream)', 'var(--color-mustard)'],
];
const ticker = ['Fishing', 'Hunting', 'Western', 'Country', 'Gym', 'Football Mom', 'Faith', 'Nurse', 'Vintage', 'Christmas', 'Thanksgiving'];
---
<Base title={`Original Graphic Tees for What You Do | Graphic Tees Co.`}
  description="Original graphic tees for men and women: fishing, hunting, western, country and gym designs, printed to order. New collection every month."
  schema={[faqPage([...answers, ...faqs]), itemListOfCollections([...tees, ...hoodies].filter((c) => live.has(c.slug)), showHoodies ? 'Graphic tee and hoodie collections' : 'Graphic tee collections')]}>

  <!-- HERO (Sam 2026-10-21, 4th pass: "use fal to create something special. High contrast. Use all of our colors").
       Market check: Bad Birdie (black ground, huge slanted headline, photo panels), Tipsy Elves (people having fun, loud buttons),
       Middle Class Fancy (deal in the hero). Ours: an original fal campaign shot (three friends cracking up in the sloth, cat and
       chihuahua designs on a rust/mustard/moss/kraft set), real cat + cartoon table from the cat design, ink panel, cream + mustard headline, rust and cream buttons, navy deal strip. -->
  <section class="hype relative bg-[#141311] text-[#f8f3e8] overflow-hidden">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.45fr)] lg:min-h-[620px]">
      <picture class="block lg:order-2 relative">
        <source media="(min-width: 1024px)" srcset="/hero/laugh-900.webp 900w, /hero/laugh-1600.webp 1600w" sizes="60vw" />
        <img src="/hero/laugh-m-700.webp" srcset="/hero/laugh-m-700.webp 700w, /hero/laugh-m-1100.webp 1100w" sizes="100vw"
          alt="Three friends cracking up in Graphic Tees Co. shirts (Replies in 3–5 Business Days, Knocked It Off. Felt Nothing., Small. Cold. Furious.) while a real cat sits on a cartoon table next to a spilled cartoon mug"
          width="1100" height="851" fetchpriority="high" class="w-full aspect-[1100/851] lg:aspect-auto lg:absolute lg:inset-0 lg:h-full object-cover object-[60%_40%] lg:object-[20%_40%]" />
        <span class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#141311] to-transparent lg:hidden"></span>
      </picture>

      <div class="relative z-10 container-x pt-6 pb-9 lg:py-14 lg:pr-6 lg:!max-w-none lg:!pl-[max(1.5rem,calc((100vw-1240px)/2+1.5rem))] flex flex-col justify-center">
        <!-- Hand-set type (Sam 2026-10-21: "fool even the best vibe coders"): poster headline with a misprinted rust
             ink layer, wood-type tagline, sentence-case buttons, a hand-drawn arrow. No eyebrow, no tracked caps. -->
        <h1>
          <span class="poster block text-[clamp(4rem,17vw,7.6rem)]">Graphic<br />Tees.</span>
          <span class="woodtype block mt-5 text-[clamp(1.6rem,6.6vw,2.9rem)] text-[#d9a23b]">Life's short.<br />Wear the laugh.</span>
        </h1>
        <p class="mt-5 max-w-sm text-[#f8f3e8]/85 text-base md:text-lg">Life's too short for boring shirts. Ours are drawn here, printed when you order, and made to get a laugh out of everybody who reads them.</p>
        <div class="mt-7 grid grid-cols-2 gap-3 max-w-md">
          <a href="/funny-graphic-tees/" class="hand-btn bg-[#c2461f] text-[#f8f3e8] [box-shadow:4px_4px_0_#d9a23b]">Shop tees</a>
          {showHoodies ? <a href="/hoodies/" class="hand-btn bg-[#f8f3e8] text-[#141311] [box-shadow:4px_4px_0_#4f5d3a]">Shop hoodies</a> : <a href="/gifts/" class="hand-btn bg-[#f8f3e8] text-[#141311] [box-shadow:4px_4px_0_#4f5d3a]">Gifts &amp; sets</a>}
        </div>
        <a href="/gifts/" class="scrawl mt-5 inline-flex items-center gap-2 self-start text-[1.35rem] text-[#f8f3e8] hover:text-[#d9a23b]">
          <svg width="36" height="22" viewBox="0 0 34 22" aria-hidden="true"><path d="M2 6 C 10 16, 20 18, 30 12 M24 8 L31 12 L26 18" fill="none" stroke="#d9a23b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          or grab a stocking stuffer
        </a>
      </div>
    </div>

    <!-- Deal strip (moving) -->
    <a href="/black-friday/" class="block bg-[#22344a] text-[#f8f3e8] border-y-2 border-[#141311] overflow-hidden" aria-label="Black Friday deals start November 8">
      <div class="deal-track flex w-max gap-8 py-2.5 text-sm md:text-base font-black uppercase tracking-[.12em] whitespace-nowrap">
        {[0, 1].map((k) => (
          <span class="flex gap-8" aria-hidden={k ? 'true' : undefined}>
            <span>Black Friday starts Nov 8</span><span class="text-[#d9a23b]">★</span><span>Buy 2, save 15%</span><span class="text-[#e2552a]">★</span><span>Buy 4+, save 25%</span><span class="text-[#d9a23b]">★</span><span>Free US shipping $45+</span><span class="text-[#e2552a]">★</span><span>Original designs only</span><span class="text-[#d9a23b]">★</span>
          </span>
        ))}
      </div>
    </a>
  </section>

  <!-- MAJOR SPOKES: 8 broad doors (CRO), then every niche in one swipe row -->
  <section class="container-x mt-14" aria-labelledby="shop-h">
    <div class="flex items-end justify-between gap-4">
      <h2 id="shop-h" class="display text-5xl md:text-6xl">Go on, <span class="text-[var(--color-rust)]">pick one.</span></h2>
      <p class="hidden md:block text-sm font-bold uppercase tracking-[.12em] text-[var(--color-rust)]">Printed to order · order 2 weeks ahead</p>
    </div>
    <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4">
      {majorCards.map((m) => (
        <a href={m.href} class="group relative overflow-hidden rounded-[18px] border-2 border-[var(--color-ink)] aspect-[4/5] flex shadow-[4px_4px_0_var(--color-ink)] hover:-translate-y-1 hover:shadow-[6px_8px_0_var(--color-ink)] transition-all bg-[var(--color-navy)]">
          {m.gifts ? (
            <span class="absolute inset-0 bg-[var(--color-mustard)]" aria-hidden="true">
              <span class="absolute inset-x-3 top-3 bottom-[49%] grid grid-cols-2 grid-rows-2 gap-2">
                {giftShots.slice(0, 4).map((g, i) => <span class={`rounded-[12px] bg-[var(--color-cream)] border-2 border-[var(--color-ink)] overflow-hidden ${i % 2 ? 'rotate-2' : '-rotate-2'} group-hover:rotate-0 transition-transform`}><img src={g.src} alt="" loading="lazy" width="300" height="300" class="w-full h-full object-contain scale-[1.35]" /></span>)}
              </span>
            </span>
          ) : m.ph && <img src={m.ph.src} srcset={m.ph.src.startsWith('/covers/') ? `${m.ph.src.replace('/covers/', '/covers/sm/')} 400w, ${m.ph.src} 600w` : undefined} sizes="(min-width: 768px) 25vw, 50vw" alt={m.ph.alt} loading="lazy" width="600" height="750" class="absolute inset-0 w-full h-full object-cover object-[50%_20%] group-hover:scale-[1.04] transition-transform duration-500" />}
          {!m.gifts && <span class="absolute inset-x-0 bottom-0 h-3/5 bg-gradient-to-t from-black/85 via-black/45 to-transparent" aria-hidden="true"></span>}
          {m.badge && <span class="absolute top-3 left-3 rounded-full bg-[var(--color-mustard)] text-[var(--color-ink)] text-[11px] font-bold uppercase tracking-[.1em] px-3 py-1 border-2 border-[var(--color-ink)]">{m.badge}</span>}
          <span class={`absolute inset-x-4 bottom-4 ${m.gifts ? 'text-[var(--color-ink)]' : 'text-[var(--color-cream)]'}`}>
            <span class="display block text-[clamp(1.3rem,5.6vw,2.6rem)] md:text-[clamp(1.8rem,3.4vw,2.6rem)] leading-[.88]">{m.title}</span>
            <span class="mt-1.5 block text-[13px] leading-snug opacity-90">{m.line}</span>
