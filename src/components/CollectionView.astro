---
import Base from '../layouts/Base.astro';
import ProductCard from './ProductCard.astro';
import type { Collection } from '../data/collections';
import { bySlug, pathFor, all } from '../data/collections';
import { getCollectionProducts, getAllProducts, shopifyConnected } from '../lib/shopify';
import { breadcrumbs, faqPage, collectionPage } from '../lib/schema';
import { resolveFaqs, site } from '../data/site';
import { coverFor } from '../data/covers';
import { HOLD, MIN_INDEX, linkableSlugs, hoodiesHubLive } from '../lib/linkable';
import ClusterLinks from './ClusterLinks.astro';
import { clusterOf } from '../data/clusters';

interface Props { collection: Collection }
const { collection: c } = Astro.props;
// Products still being built (no photos yet) stay off the grid until they're finished.
const products = (await getCollectionProducts(c.shopifyHandle)).filter((p) => p.sample || p.images.length > 0);
const live = await linkableSlugs();
// Themed rows (Sam 2026-10-21: "titles then carousel for easier viewing, scroll 3, then see all"): on pages with 10+
// products, group by the niche in the title ("Women's Baseball Mom – …" -> Sports). Every product stays in the HTML.
const THEMES: [string, RegExp][] = [
  ['Holidays', /christmas|thanksgiving|halloween|hanukkah|valentine|easter|new year/i],
  ['Sports & game day', /baseball|softball|football|soccer|golf|pickleball|tennis|hockey|basketball|bowling|cornhole|volleyball|travel ball|gym|running|lifting|cheer/i],
  ['Outdoors', /fishing|hunting|camping|hiking|national park|western|country|lake|boat|birding|outdoors|ranch|rodeo|garden/i],
  ['Pets & animals', /cat|dog|frenchie|french bulldog|retriever|pit bull|dachshund|capybara|bigfoot|owl|sloth|donkey|pug|goat|chicken|horse|bear|raccoon|possum|frog|duck|deer|animal/i],
];
const nicheOf = (t: string) => t.split('–')[0].replace(/^(men's|women's|unisex|baby|kids'?|youth)\s+/i, '');
const themed = products.length >= 10
  ? [...THEMES.map(([name, rx]) => ({ name, items: products.filter((p) => rx.test(nicheOf(p.title)) && !THEMES.slice(0, THEMES.findIndex((t) => t[0] === name)).some(([, r]) => r.test(nicheOf(p.title)))) })),
     { name: 'Everyday humor', items: products.filter((p) => !THEMES.some(([, rx]) => rx.test(nicheOf(p.title)))) }]
    .filter((g) => g.items.length > 0)
  : null;
// When one theme holds most of the page (e.g. every product on /christmas-shirts/ is "Holidays"), group by product type instead.
const TYPES: [string, RegExp][] = [
  ['Tees', /(tee|t-shirt|shirt)$/i],
  ['Sweatshirts', /(crewneck sweatshirt|sweatshirt|sweater)$/i],
  ['Hoodies & zips', /(hoodie|half-zip|half zip pullover|pullover)$/i],
  ['Gifts & add-ons', /(ornament|mug|socks|sweatpants|bandana)$/i],
  ['Kids & family', /(bodysuit|youth long sleeve tee|youth tee)$/i],
];
const typeOf = (t: string) => TYPES.find(([, rx]) => rx.test(t.trim()))?.[0] ?? 'More';
const byType = products.length >= 10
  ? [...TYPES.map(([name]) => name), 'More'].map((name) => ({ name, items: products.filter((p) => typeOf(p.title) === name) })).filter((g) => g.items.length > 0)
  : null;
const themeTooBroad = !!themed && themed.length > 0 && Math.max(...themed.map((g) => g.items.length)) / products.length > 0.7;
const audOf = (t: string) => /^women's/i.test(t) ? "For her" : /^men's/i.test(t) ? 'For him' : /^(baby|kids|youth)/i.test(t) ? 'Kids & family' : 'For everyone';
const byAudience = products.length >= 10
  ? ['For her', 'For him', 'For everyone', 'Kids & family'].map((name) => ({ name, items: products.filter((p) => audOf(p.title) === name) })).filter((g) => g.items.length > 0)
  : null;
const baseRows = themed && themed.length > 1 && !themeTooBroad ? themed
  : byType && byType.length > 1 ? byType
  : byAudience && byAudience.length > 1 ? byAudience : null;
// Thin themed rows (Sam 2026-10-21: "this catalog should be so much bigger than 1 product"): top a row up to 6 with the
// same kind of design from across the store, same garment first, then the same design on other garments. The page's own
// products come first and stay the only ones in the collection schema; the extras are discovery.
const ROW_MIN = 6;
const everyone = baseRows === themed && themed ? (await getAllProducts()).filter((p) => !p.sample && p.images.length > 0) : [];
const onPage = new Set(products.map((p) => p.handle));
const garment = (h: string) => (/zip-hoodie|hoodie/.test(h) ? 'hoodie' : /sweatshirt/.test(h) ? 'sweat' : /graphic-tee/.test(h) ? 'tee' : 'other');
const pageGarment = products.length ? garment(products[0].handle) : 'other';
const rows = baseRows?.map((g) => {
  const rx = THEMES.find(([n]) => n === g.name)?.[1];
  if (!rx || g.items.length >= ROW_MIN || !everyone.length) return g;
  const used = new Set(g.items.map((p) => p.handle));
  const pool = everyone.filter((p) => !onPage.has(p.handle) && !used.has(p.handle) && rx.test(nicheOf(p.title)) && garment(p.handle) !== 'other');
  pool.sort((a, b) => Number(garment(b.handle) === pageGarment) - Number(garment(a.handle) === pageGarment));
  return { ...g, items: [...g.items, ...pool.slice(0, ROW_MIN - g.items.length)] };
}) ?? null;
const twinC = c.twin ? bySlug(c.twin) : undefined;
const twin = twinC && live.has(twinC.slug) ? twinC : undefined;
const faqs = resolveFaqs(c.faqs);
const crumbs = [
  { name: 'Home', path: '/' },
  ...(c.section === 'hoodies' ? [{ name: 'Hoodies', path: '/hoodies/' }] : []),
  { name: c.h1, path: pathFor(c) },
];
// Dark collection trial (Sam 2026-10-21): zip-ups only for now; add slugs here to roll it out.
const DARK_PAGES = new Set(['zip-up-hoodies']);
const darkPage = DARK_PAGES.has(c.slug);
const cluster = clusterOf(c.slug);
// Cluster siblings are listed in ClusterLinks, so "More collections" skips them.
const related = all.filter((x) => !cluster || (x.slug !== cluster.hub.slug && !cluster.spokes.includes(x.slug))).filter((x) => x.section === c.section && x.slug !== c.slug && !!x.seasonal === !!c.seasonal && live.has(x.slug)).slice(0, 6);
// A collection with fewer than MIN_INDEX products is a thin page and stays out of the index until filled.
// Off-target head terms and duplicate pages stay out too (HOLD, src/lib/linkable.ts).
// Share/AI preview image: the first product's lifestyle cover, else its product photo (was og-default for every page).
const firstCover = products.map((p) => coverFor(p.handle)).find(Boolean);
const shareImage = firstCover ? `${site.url}${firstCover.src}` : products[0]?.images[0]?.url;
const noindex = (shopifyConnected && products.length < MIN_INDEX) || HOLD.has(c.slug);
---
<Base title={c.title} description={c.description} noindex={noindex} image={shareImage}
  schema={[breadcrumbs(crumbs), faqPage(faqs), collectionPage(c, products)]}>
  <div class={darkPage ? 'theme-dark pb-16' : ''}>
  <nav aria-label="Breadcrumb" class="container-x pt-6 text-xs text-[var(--color-ink-2)]">
    {crumbs.map((b, i) => <>{i > 0 && ' / '}{i < crumbs.length - 1 ? <a href={b.path} class="hover:underline">{b.name}</a> : <span>{b.name}</span>}</>)}
  </nav>

  <section class="container-x pt-6 pb-8">
    <p class="eyebrow text-[var(--color-rust)]">{c.seasonal ? 'Seasonal drop' : c.section === 'hoodies' ? 'Graphic hoodies' : 'Graphic tees'}</p>
    <h1 class="display text-5xl md:text-7xl mt-2 text-[var(--color-navy)]">{c.h1}<span class="block mt-3 h-1.5 w-20 rounded-full bg-[var(--color-rust)]"></span></h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-ink-2)]">{c.intro}</p>
    {twin && <a href={pathFor(twin)} class="inline-block mt-4 font-semibold underline decoration-[var(--color-rust)] underline-offset-4">Also on a {twin.section === 'hoodies' ? 'hoodie' : 'tee'} → {twin.h1}</a>}
  </section>

  <section class="container-x" aria-label="Products">
    {products.length > 0 && rows ? (
      <div class="grid gap-12">
        {rows.map((g, gi) => (
          <section data-row aria-label={g.name} class="min-w-0">
            <div class="flex items-end justify-between gap-3 border-b-2 border-[var(--color-rust)] pb-2">
              <h2 class="display text-[clamp(1.8rem,7vw,2.6rem)] leading-[.9] text-[var(--color-navy)]">{g.name}</h2>
              {g.items.length > 3 && <button type="button" data-row-toggle class="shrink-0 rounded-full border-2 border-[var(--color-navy)] bg-[var(--color-cream)] text-[var(--color-navy)] px-4 py-1.5 text-xs font-extrabold uppercase tracking-[.1em] shadow-[2px_2px_0_var(--color-rust)] hover:bg-[var(--color-rust)] hover:text-[var(--color-cream)]">See all</button>}
            </div>
            <div data-row-track class="mt-5 -mx-4 px-4 scroll-px-4 flex gap-4 overflow-x-auto snap-x snap-mandatory pb-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              {g.items.map((p, i) => <div class="snap-start shrink-0 w-[42%] sm:w-[30%] md:w-[23%]"><ProductCard product={p} audience={c.audience} eager={gi === 0 && i < 2} /></div>)}
            </div>
          </section>
        ))}
      </div>
    ) : products.length > 0 ? (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-8">
        {products.map((p, i) => <ProductCard product={p} audience={c.audience} eager={i < 2} />)}
      </div>
    ) : (
      <p class="py-12 text-center text-[var(--color-ink-2)]">New designs are dropping here soon.</p>
    )}
    {products.some((p) => p.sample) && <p class="mt-6 text-xs text-[var(--color-ink-2)]">Preview: sample products shown until the Shopify store is connected.</p>}
    {cluster && <ClusterLinks cluster={cluster} current={c.slug} title={cluster.hub.slug === c.slug ? `Shop ${cluster.name} by style` : undefined} class="mt-12" />}
  </section>

  <section class="container-x mt-16 grid md:grid-cols-[2fr_1fr] gap-12">
    <div class="prose-copy">
      {c.sections.map((s) => <><h2>{s.h2}</h2><p>{s.body}</p></>)}
      <h2>FAQ</h2>
      <dl class="grid gap-4 mt-4">
        {faqs.map((f) => (
          <div><dt class="font-semibold">{f.q}</dt><dd class="text-[var(--color-ink-2)] mt-1">{f.a}</dd></div>
        ))}
      </dl>
    </div>
    <aside>
      <p class="eyebrow mb-3">More collections</p>
      <ul class="grid gap-2">
        {related.map((r) => <li><a href={pathFor(r)} class="font-semibold hover:text-[var(--color-rust)]">{r.h1} →</a></li>)}
        {c.section === 'tees' ? hoodiesHubLive() && <li><a href="/hoodies/" class="font-semibold hover:text-[var(--color-rust)]">Graphic hoodies →</a></li>
          : <li><a href="/graphic-tees-for-men/" class="font-semibold hover:text-[var(--color-rust)]">Graphic tees →</a></li>}
      </ul>
    </aside>
  </section>
  </div>
  <script>
    // "See all" turns a row's swipe track into a full grid (and back).
    document.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
      const btn = row.querySelector<HTMLButtonElement>('[data-row-toggle]');
      const track = row.querySelector<HTMLElement>('[data-row-track]');
      if (!btn || !track) return;
      const grid = 'mt-5 grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-8';
      const swipe = track.className;
      btn.addEventListener('click', () => {
        const open = btn.textContent === 'See all';
        track.className = open ? grid : swipe;
        track.querySelectorAll<HTMLElement>(':scope > div').forEach((d) => { d.dataset.cls ??= d.className; d.className = open ? '' : d.dataset.cls; });
        btn.textContent = open ? 'Show less' : 'See all';
      });
    });
  </script>
</Base>
