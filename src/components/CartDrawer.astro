<div data-cart-drawer hidden class="fixed inset-0 z-50">
  <div data-cart-close class="absolute inset-0 bg-black/40"></div>
  <aside class="absolute right-0 top-0 h-full w-full max-w-sm bg-[var(--color-paper)] shadow-2xl flex flex-col" aria-label="Cart">
    <div class="flex items-center justify-between p-4 border-b border-[var(--color-line)]">
      <p class="display text-2xl">Your Cart</p>
      <button type="button" data-cart-close class="text-sm font-semibold uppercase">Close</button>
    </div>
    <div data-cart-lines class="flex-1 overflow-y-auto p-4 grid content-start gap-4 text-sm"></div>
    <div class="p-4 border-t border-[var(--color-line)] grid gap-3">
      <div class="flex justify-between font-semibold"><span>Subtotal</span><span data-cart-subtotal>$0.00</span></div>
      <a data-cart-checkout href="#" class="btn btn-rust w-full" aria-disabled="true">Checkout</a>
      <p class="text-xs text-[var(--color-ink-2)]">Shipping and taxes are calculated at checkout.</p>
    </div>
  </aside>
</div>

<script>
  import { cartEnabled, getCart, addLine, updateLine, type Cart } from '../lib/cart';

  const drawer = document.querySelector<HTMLElement>('[data-cart-drawer]')!;
  const linesEl = drawer.querySelector<HTMLElement>('[data-cart-lines]')!;
  const subtotalEl = drawer.querySelector<HTMLElement>('[data-cart-subtotal]')!;
  const checkoutEl = drawer.querySelector<HTMLAnchorElement>('[data-cart-checkout]')!;

  const open = () => { drawer.hidden = false; document.body.style.overflow = 'hidden'; };
  const close = () => { drawer.hidden = true; document.body.style.overflow = ''; };
  document.querySelectorAll('[data-cart-open]').forEach((b) => b.addEventListener('click', open));
  drawer.querySelectorAll('[data-cart-close]').forEach((b) => b.addEventListener('click', close));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function render(cart: Cart | null) {
    document.querySelectorAll('[data-cart-count]').forEach((el) => (el.textContent = String(cart?.totalQuantity ?? 0)));
    if (!cartEnabled) {
      linesEl.innerHTML = '<p class="text-[var(--color-ink-2)]">The store opens soon — checkout is not connected yet.</p>';
      return;
    }
    if (!cart || cart.lines.length === 0) {
      linesEl.innerHTML = '<p class="text-[var(--color-ink-2)]">Your cart is empty.</p>';
      subtotalEl.textContent = '$0.00';
      checkoutEl.setAttribute('aria-disabled', 'true');
      checkoutEl.href = '#';
      return;
    }
    linesEl.innerHTML = cart.lines.map((l) => `
      <div class="flex gap-3">
        ${l.image ? `<img src="${esc(l.image)}&width=160" alt="" width="64" height="64" class="w-16 h-16 object-cover bg-[var(--color-paper-2)]">` : '<div class="w-16 h-16 bg-[var(--color-paper-2)]"></div>'}
        <div class="flex-1">
          <p class="font-semibold">${esc(l.title)}</p>
          <p class="text-[var(--color-ink-2)]">${esc(l.variant)} · ${esc(l.price)}</p>
          <div class="mt-1 flex items-center gap-2">
            <button type="button" data-qty="${esc(l.id)}" data-to="${l.quantity - 1}" class="px-2 border border-[var(--color-line)]" aria-label="Decrease quantity">−</button>
            <span>${l.quantity}</span>
            <button type="button" data-qty="${esc(l.id)}" data-to="${l.quantity + 1}" class="px-2 border border-[var(--color-line)]" aria-label="Increase quantity">+</button>
          </div>
        </div>
      </div>`).join('');
    subtotalEl.textContent = cart.subtotal;
    checkoutEl.href = cart.checkoutUrl;
    checkoutEl.removeAttribute('aria-disabled');
  }

  linesEl.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-qty]');
    if (!b) return;
    b.disabled = true;
    render(await updateLine(b.dataset.qty!, Number(b.dataset.to)));
  });

  // Add-to-cart from product pages: <form data-add-to-cart> with a [name=variant] field.
  document.addEventListener('submit', async (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('form[data-add-to-cart]');
    if (!form) return;
    e.preventDefault();
    const variant = new FormData(form).get('variant') as string;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
    if (!variant || !cartEnabled) return;
    if (btn) btn.disabled = true;
    try { render(await addLine(variant)); open(); } finally { if (btn) btn.disabled = false; }
  });

  getCart().then(render).catch(() => render(null));
</script>
