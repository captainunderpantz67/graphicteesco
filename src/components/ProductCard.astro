---
import type { Product } from '../lib/shopify';
import { formatPrice } from '../lib/shopify';
import { coverFor } from '../data/covers';
import { SWATCH } from '../lib/swatches';
// eager: the first row of a grid is above the fold on phones, so it loads right away (LCP).
interface Props { product: Product; audience?: 'women' | 'men'; eager?: boolean }
const { product: p, audience, eager = false } = Astro.props;
const href = p.sample ? undefined : `/products/${p.handle}/`;
const Tag = href ? 'a' : 'div';
// On a women's/men's page, never lead with a lifestyle photo of the other audience
// (Sam, 2026-10-15: "that's a man in the women section") — fall back to the product shot.
const rawCover = coverFor(p.handle);
const wrongAudience = rawCover && ((audience === 'women' && /^(man|men)\b/i.test(rawCover.alt)) || (audience === 'men' && /^(woman|women)\b/i.test(rawCover.alt)));
const cover = wrongAudience ? null : rawCover;
// Grid cues shoppers scan for (2026-10-15 competitor study): colors at a glance, NEW, matching sets.
const colors = (p.options.find((o) => o.name === 'Color')?.values ?? []).filter((c) => SWATCH[c]);
const shownColors = colors.slice(0, 5);
const isNew = !!p.createdAt && Date.now() - Date.parse(p.createdAt) < 14 * 864e5;
const sibling = p.handle.endsWith('-graphic-tee') ? p.handle.replace(/-graphic-tee$/, '-crewneck-sweatshirt')
  : p.handle.endsWith('-crewneck-sweatshirt') ? p.handle.replace(/-crewneck-sweatshirt$/, '-graphic-tee') : null;
const matchingSet = !!sibling && !!coverFor(sibling);
// Zip-ups carry the joke on the back (small chest mark in front): show the back print first (Sam 2026-10-20: "I couldn't see the snarky backs").
const isZip = /zip/i.test(p.title) && /hood/i.test(`${p.productType} ${p.title}`);
const hero = (isZip && p.images.find((i) => /-back[-.]/i.test(i.url))) || p.featuredImage;
// Card title (Sam 2026-10-21): lead with the joke, put "Women's zip hoodie · Baseball Mom" underneath.
// The product page and its <title> keep the full keyword title, so search is unaffected.
const TYPES = /\s+(zip hoodie|oversized hoodie|heavyweight hoodie|cropped hoodie|half[- ]zip pullover|hoodie|crewneck sweatshirt|sweatshirt|long sleeve tee|graphic tee|tee|t-shirt|baby bodysuit|bodysuit|ornament|mug|socks|sweatpants|bandana)$/i;
const [left, ...rest] = p.title.split(/\s+–\s+/);
const rightRaw = rest.join(' – ');
const typeMatch = rightRaw.match(TYPES);
const joke = rest.length ? rightRaw.replace(TYPES, '').trim() || rightRaw : p.title;
const aud = (left.match(/^(men's|women's|unisex|baby|kids'?|youth)\b/i)?.[1] ?? '').replace(/^unisex$/i, '');
const niche = left.replace(/^(men's|women's|unisex|baby|kids'?|youth)\s+/i, '');
const typeName = typeMatch ? typeMatch[1].toLowerCase() : '';
const subline = rest.length ? [[aud, typeName].filter(Boolean).join(' '), niche].filter(Boolean).join(' · ') : '';
const cmp = p.variants.find((v) => v.compareAtPrice && Number(v.compareAtPrice.amount) > Number(v.price.amount))?.compareAtPrice;
const was = cmp ? formatPrice(cmp) : null;
---
<Tag href={href} class="group block">
  <div class="relative aspect-[4/5] bg-[var(--color-paper-2)] grain overflow-hidden flex items-center justify-center">
    {(isNew || matchingSet) && (
      <div class="absolute top-2 left-2 z-10 flex flex-col items-start gap-1">
        {isNew && <span class="bg-[var(--color-ink)] text-[var(--color-paper)] text-[10px] font-bold tracking-wider uppercase px-2 py-0.5">New</span>}
        {matchingSet && <span class="bg-[var(--color-paper)] text-[var(--color-ink)] border border-[var(--color-ink)] text-[10px] font-bold tracking-wider uppercase px-2 py-0.5">Matching set</span>}
      </div>
    )}
    {cover ? (
      <img src={cover.src} srcset={`${cover.src.replace('/covers/', '/covers/sm/')} 400w, ${cover.src} 600w`}
        sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw" alt={cover.alt} width="600" height="750" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async"
        class="w-full h-full object-cover object-[50%_25%] group-hover:scale-[1.03] transition-transform duration-300" />
    ) : hero ? (
      <img
        src={`${hero.url}&width=600`}
        srcset={`${hero.url}&width=320 320w, ${hero.url}&width=600 600w`}
        sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
        alt={hero.altText && !/^product mockup$/i.test(hero.altText.trim()) ? hero.altText : `${p.title.replace(/^.*?–\s*/, '')} graphic tee, ${p.title.split('–')[0].trim()}`}
        width="600" height="750" loading={eager ? 'eager' : 'lazy'} decoding="async"
        class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
      />
    ) : (
      <span class="display text-[var(--color-line)] text-5xl">{p.productType === 'Hoodie' ? 'Hoodie' : 'Tee'}</span>
    )}
  </div>
  <div class="mt-3 flex justify-between gap-2 text-sm">
    <div class="min-w-0">
      <p class="font-semibold leading-snug group-hover:text-[var(--color-rust)]">{joke}</p>
      {subline && <p class="mt-0.5 text-xs text-[var(--color-ink-2)] first-letter:uppercase">{subline}</p>}
    </div>
    <p class="text-[var(--color-ink-2)] whitespace-nowrap">{formatPrice(p.priceRange.minVariantPrice)}{was && <s class="ml-1.5 text-xs">{was}</s>}</p>
  </div>
  {shownColors.length > 1 && (
    <div class="mt-2 flex items-center gap-1.5" aria-label={`Available in ${colors.length} colors`}>
      {shownColors.map((c) => <span class="block w-3.5 h-3.5 rounded-full border border-black/20" style={`background:${SWATCH[c]}`} title={c}></span>)}
      {colors.length > shownColors.length && <span class="text-xs text-[var(--color-ink-2)]">+{colors.length - shownColors.length}</span>}
    </div>
  )}
</Tag>
