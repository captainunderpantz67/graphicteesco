---
// Hero visual. If a Printful mockup PNG is provided (site.heroImage), it renders the
// model shot on a printed "poster" backdrop. Until then: original artwork — a tee
// carrying a two-ink screen print (sunburst, mesa, lake, jumping bass).
interface Props { image?: { src: string; alt: string; srcSmall?: string } }
const { image } = Astro.props;
---
<div class="relative aspect-[4/5] w-full max-w-[520px] mx-auto">
  <!-- Poster backdrop -->
  <div class="absolute inset-[6%] rounded-[28px] bg-[var(--color-navy)] overflow-hidden rotate-2 shadow-[10px_12px_0_var(--color-rust)]">
    <div class="absolute inset-0 halftone-rust opacity-60"></div>
    <svg viewBox="0 0 400 500" class="absolute inset-0 w-full h-full" aria-hidden="true">
      <g fill="var(--color-mustard)" opacity=".22">
        {Array.from({ length: 18 }, (_, i) => (
          <path d={`M200 260 L${200 + 520 * Math.cos((i * 20 * Math.PI) / 180)} ${260 + 520 * Math.sin((i * 20 * Math.PI) / 180)} L${200 + 520 * Math.cos(((i * 20 + 9) * Math.PI) / 180)} ${260 + 520 * Math.sin(((i * 20 + 9) * Math.PI) / 180)}Z`} />
        ))}
      </g>
    </svg>
  </div>

  {image ? (
    <div class="absolute inset-[6%] rounded-[28px] overflow-hidden rotate-2 border-2 border-[var(--color-ink)]">
      <img src={image.src} srcset={image.srcSmall ? `${image.srcSmall} 640w, ${image.src} 1040w` : undefined}
        sizes="(min-width: 1024px) 480px, 92vw" alt={image.alt} width="1040" height="1393" fetchpriority="high"
        class="w-full h-full object-cover" />
    </div>
  ) : (
    <svg viewBox="0 0 400 500" class="drop absolute inset-0 w-full h-full" role="img" aria-label="Original screen-printed graphic tee artwork: a bass jumping over a lake under a desert sunburst">
      <defs>
        <clipPath id="print"><circle cx="200" cy="248" r="92" /></clipPath>
        <filter id="rough"><feTurbulence baseFrequency=".9" numOctaves="2" result="t"/><feDisplacementMap in="SourceGraphic" in2="t" scale="2.2"/></filter>
      </defs>
      <!-- Tee -->
      <path d="M128 92 64 124l-34 70 52 26 22-30v232h192V190l22 30 52-26-34-70-64-32c-8 24-36 40-72 40s-64-16-72-40z"
        fill="var(--color-cream)" stroke="var(--color-ink)" stroke-width="4" stroke-linejoin="round" />
      <path d="M128 92c8 24 36 40 72 40s64-16 72-40" fill="none" stroke="var(--color-ink)" stroke-width="4" />
      <path d="M104 420h192" stroke="var(--color-ink)" stroke-width="2" stroke-dasharray="4 5" opacity=".5" />
      <!-- Print (ink 2 offset under ink 1 = misregistration) -->
      <g filter="url(#rough)">
        <g transform="translate(5 5)" clip-path="url(#print)">
          <rect x="100" y="150" width="200" height="200" fill="var(--color-navy)" />
        </g>
        <g clip-path="url(#print)">
          <rect x="100" y="150" width="200" height="200" fill="var(--color-mustard)" />
          <g fill="var(--color-rust)">
            {Array.from({ length: 12 }, (_, i) => (
              <path d={`M200 250 L${200 + 140 * Math.cos(((i * 30 - 180) * Math.PI) / 180)} ${250 + 140 * Math.sin(((i * 30 - 180) * Math.PI) / 180)} L${200 + 140 * Math.cos(((i * 30 - 168) * Math.PI) / 180)} ${250 + 140 * Math.sin(((i * 30 - 168) * Math.PI) / 180)}Z`} />
            ))}
          </g>
          <circle cx="200" cy="250" r="30" fill="var(--color-cream)" />
          <path d="M100 285 L140 240 L165 262 L200 222 L238 268 L262 248 L300 290 V350 H100Z" fill="var(--color-ink)" />
          <rect x="100" y="292" width="200" height="60" fill="var(--color-navy)" />
          <path d="M110 305h40M170 312h55M240 304h45M130 324h60M210 330h50" stroke="var(--color-cream)" stroke-width="3" stroke-linecap="round" opacity=".7" />
          <!-- jumping bass -->
          <g transform="translate(206 300) rotate(-24)">
            <path d="M-46 0c14-17 44-20 64-7l18-11v34l-18-11c-20 13-50 10-64-5z" fill="var(--color-cream)" stroke="var(--color-ink)" stroke-width="3" />
            <circle cx="-30" cy="-3" r="2.8" fill="var(--color-ink)" />
            <path d="M-12-12c4 6 4 16 0 22" stroke="var(--color-rust)" stroke-width="2.5" fill="none" />
            <path d="M-20 18c-6 4-14 4-20 0" stroke="var(--color-cream)" stroke-width="2" fill="none" opacity=".8" />
          </g>
        </g>
        <circle cx="200" cy="248" r="92" fill="none" stroke="var(--color-ink)" stroke-width="5" />
      </g>
      <!-- Arched text -->
      <path id="arcTop" d="M94 248a106 106 0 0 1 212 0" fill="none" />
      <text font-family="Big Shoulders Display, Impact, sans-serif" font-weight="900" font-size="19" letter-spacing="3" fill="var(--color-ink)">
        <textPath href="#arcTop" startOffset="50%" text-anchor="middle">LAKE · LIFE · CLUB</textPath>
      </text>
      <text x="200" y="378" text-anchor="middle" font-family="Yellowtail, cursive" font-size="34" fill="var(--color-rust)">Since Sunrise</text>
    </svg>
  )}

  {image && (
    <img src="/hero/logo-badge.png" alt="Graphic Tees Co. badge" width="180" height="180" loading="eager"
      class="absolute -bottom-3 -left-2 md:-left-4 w-28 h-28 md:w-36 md:h-36 -rotate-12 rounded-full shadow-[4px_5px_0_var(--color-ink)]" />
  )}
  <!-- Spinning sticker -->
  <div class="absolute -top-2 -right-1 md:right-2 w-28 h-28 md:w-32 md:h-32">
    <svg viewBox="0 0 120 120" class="spin-slow w-full h-full" aria-hidden="true">
      <defs><path id="ring" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0" /></defs>
      <circle cx="60" cy="60" r="58" fill="var(--color-mustard)" stroke="var(--color-ink)" stroke-width="3" />
      <text font-family="Archivo, sans-serif" font-weight="800" font-size="11.5" letter-spacing="1.5" fill="var(--color-ink)">
        <textPath href="#ring">ORIGINAL ART ✦ PRINTED TO ORDER ✦</textPath>
      </text>
    </svg>
    <svg viewBox="0 0 120 120" class="absolute inset-0 w-full h-full" aria-hidden="true"><polygon points="60.00,44.60 64.11,55.94 76.17,56.35 66.66,63.76 69.99,75.35 60.00,68.60 50.01,75.35 53.34,63.76 43.83,56.35 55.89,55.94" fill="var(--color-rust)" /></svg>
  </div>
</div>
