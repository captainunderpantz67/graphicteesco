---
import '../styles/global.css';
import { site } from '../data/site';
import { tees, hoodies, pathFor } from '../data/collections';
import { organization, website } from '../lib/schema';
import CartDrawer from '../components/CartDrawer.astro';
import { linkableSlugs, hoodiesHubLive } from '../lib/linkable';
import { byUpcoming } from '../lib/holidays';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  image?: string;
  noindex?: boolean;
  theme?: 'bf';
}
const { title, description, schema = [], image, noindex = false, theme } = Astro.props;
const ogImage = image ?? `${site.url}/og-default.png`;
const canonical = new URL(Astro.url.pathname, site.url).href;
// Nav and footer only link to collections that have products and are indexable.
const live = await linkableSlugs();
const liveTees = tees.filter((c) => live.has(c.slug));
const liveHoodies = hoodies.filter((c) => live.has(c.slug));
const showHoodies = hoodiesHubLive() && liveHoodies.length > 0;
const evergreenTees = liveTees.filter((c) => !c.seasonal);
// Holiday collections, soonest holiday first (tees before hoodies within a holiday).
const seasonal = byUpcoming([...liveTees, ...liveHoodies].filter((c) => c.seasonal));
const ld = [organization(live), website(), ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || import.meta.env.PUBLIC_PREVIEW) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1c1b19" />
    <link rel="preload" href="/fonts/big-shoulders-display-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    {/* GA4 (Sam created 2026-10-20). ai_source tags visits from AI assistants (ChatGPT, Perplexity, Gemini, Copilot, Claude) for the Black Friday "boomers shop via ChatGPT" test. */}
    {!import.meta.env.PUBLIC_PREVIEW && <>
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-0KY0KGZ6PQ"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        (function () {
          var src = (new URLSearchParams(location.search).get('utm_source') || '') + ' ' + document.referrer;
          var m = src.match(/chatgpt|openai|perplexity|gemini|bard|copilot|claude|anthropic/i);
          if (m) { try { sessionStorage.setItem('ai_source', m[0].toLowerCase()); } catch (e) {} }
          var ai; try { ai = sessionStorage.getItem('ai_source'); } catch (e) {}
          gtag('config', 'G-0KY0KGZ6PQ', ai ? { ai_source: ai } : {});
          if (ai) gtag('set', 'user_properties', { ai_source: ai });
        })();
      </script>
    </>}
    {ld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class={theme === 'bf' ? 'page-bf' : undefined}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-2 focus:bg-[var(--color-ink)] focus:text-white">Skip to content</a>
    <div class="bg-[var(--color-ink)] text-[var(--color-cream)] text-center text-[11px] font-bold uppercase py-2 tracking-[.16em]">
      New designs drop every month · {site.facts.hoodiesLive ? 'Every design also comes on a hoodie' : 'Original art, printed to order'}
    </div>
    <div class="top-bar bg-[var(--color-ink)] text-[var(--color-paper)] text-center text-xs font-bold tracking-wider uppercase py-1.5 px-4">Holiday sale: tees $24.99 · Free US shipping on $45+ · <a href="/black-friday/" class="underline underline-offset-2 hover:text-[var(--color-mustard)]">Black Friday Deals</a></div>
    <header class="site-header border-b-2 border-[var(--color-ink)] bg-[var(--color-paper)]/95 backdrop-blur sticky top-0 z-30">
      <div class="container-x flex items-center justify-between h-16 gap-4">
        <a href="/" class="display misprint text-3xl tracking-tight">{site.name}</a>
        <nav aria-label="Main" class="hidden md:flex items-center gap-6 text-sm font-semibold uppercase tracking-wide">
          <a href="/black-friday/" class="rounded-full bg-[var(--color-ink)] text-[var(--color-mustard)] px-3 py-1 hover:bg-[var(--color-rust)] hover:text-[var(--color-cream)]">Black Friday</a>
          <a href="/gifts/" class="text-[var(--color-rust)] hover:text-[var(--color-ink)]">Gifts</a>
          <a href="/graphic-tees-for-men/" class="hover:text-[var(--color-rust)]">Men</a>
          <a href="/graphic-tees-for-women/" class="hover:text-[var(--color-rust)]">Women</a>
          {seasonal.length > 0 && <details class="relative group">
            <summary class="cursor-pointer list-none text-[var(--color-rust)] hover:text-[var(--color-ink)]">Holidays ▾</summary>
            <div class="absolute left-0 mt-3 w-64 bg-[var(--color-paper)] border border-[var(--color-line)] shadow-lg p-3 grid gap-1 normal-case tracking-normal font-medium">
              {seasonal.map((c) => <a class="px-2 py-1 hover:bg-[var(--color-paper-2)]" href={pathFor(c)}>{c.h1}</a>)}
            </div>
          </details>}
          <details class="relative group">
            <summary class="cursor-pointer list-none hover:text-[var(--color-rust)]">Tees ▾</summary>
            <div class="absolute left-0 mt-3 w-60 bg-[var(--color-paper)] border border-[var(--color-line)] shadow-lg p-3 grid gap-1 normal-case tracking-normal font-medium">
              {evergreenTees.map((c) => <a class="px-2 py-1 hover:bg-[var(--color-paper-2)]" href={pathFor(c)}>{c.name}</a>)}
            </div>
          </details>
          {showHoodies && <details class="relative group">
            <summary class="cursor-pointer list-none hover:text-[var(--color-rust)]">Hoodies ▾</summary>
            <div class="absolute left-0 mt-3 w-60 bg-[var(--color-paper)] border border-[var(--color-line)] shadow-lg p-3 grid gap-1 normal-case tracking-normal font-medium">
              <a class="px-2 py-1 font-bold hover:bg-[var(--color-paper-2)]" href="/hoodies/">All graphic hoodies</a>
              {liveHoodies.filter((c) => !c.seasonal).map((c) => <a class="px-2 py-1 hover:bg-[var(--color-paper-2)]" href={pathFor(c)}>{c.name}</a>)}
            </div>
          </details>}
        </nav>
        <div class="flex items-center gap-3">
          <button type="button" data-cart-open class="relative font-semibold uppercase text-sm tracking-wide">
            Cart (<span data-cart-count>0</span>)
          </button>
          <details class="md:hidden">
            <summary class="list-none cursor-pointer font-semibold uppercase text-sm" aria-label="Menu">Menu</summary>
            <div class="absolute left-0 right-0 top-16 bg-[var(--color-paper)] border-b border-[var(--color-line)] p-4 grid gap-2 z-40 max-h-[80vh] overflow-y-auto">
              <div class="grid grid-cols-2 gap-2 mb-2">
                <a href="/black-friday/" class="rounded-[12px] bg-[var(--color-ink)] text-[var(--color-mustard)] border-2 border-[var(--color-ink)] px-3 py-3 text-center font-extrabold uppercase tracking-[.08em] text-sm">Black Friday</a>
                <a href="/gifts/" class="rounded-[12px] bg-[var(--color-rust)] text-[var(--color-cream)] border-2 border-[var(--color-ink)] px-3 py-3 text-center font-extrabold uppercase tracking-[.08em] text-sm">Gifts &amp; stockings</a>
              </div>
              {seasonal.length > 0 && <p class="text-xs font-bold uppercase tracking-[.14em] text-[var(--color-rust)]">Holidays</p>}
              {seasonal.map((c) => <a href={pathFor(c)} class="font-semibold text-[var(--color-rust)]">{c.h1}</a>)}
              {seasonal.length > 0 && <p class="mt-2 text-xs font-bold uppercase tracking-[.14em] text-[var(--color-ink-2)]">Shop</p>}
              <a href="/graphic-tees-for-men/">Men's graphic tees</a>
              <a href="/graphic-tees-for-women/">Women's graphic tees</a>
              {showHoodies && <a href="/hoodies/">Graphic hoodies</a>}
              {evergreenTees.filter((c) => c.slug !== 'graphic-tees-for-men' && c.slug !== 'graphic-tees-for-women').map((c) => <a href={pathFor(c)}>{c.name}</a>)}
            </div>
          </details>
        </div>
      </div>
    </header>
    <!-- Shop bar (Sam 2026-10-21: Black Friday and gifts must be one tap away on every page, no menu needed). -->
    <nav aria-label="Shop" class="shop-bar border-b-2 border-[var(--color-ink)] bg-[var(--color-cream)]">
      <div class="container-x flex gap-2 overflow-x-auto py-2.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <a href="/black-friday/" class="shrink-0 rounded-full bg-[var(--color-ink)] text-[var(--color-mustard)] border-2 border-[var(--color-ink)] px-4 py-2 text-sm font-extrabold uppercase tracking-[.08em]">Black Friday deals</a>
        <a href="/gifts/" class="shrink-0 rounded-full bg-[var(--color-rust)] text-[var(--color-cream)] border-2 border-[var(--color-ink)] px-4 py-2 text-sm font-extrabold uppercase tracking-[.08em]">Gifts</a>
        {seasonal.slice(0, 1).map((c) => <a href={pathFor(c)} class="shrink-0 rounded-full bg-[var(--color-paper)] border-2 border-[var(--color-ink)] px-4 py-2 text-sm font-extrabold uppercase tracking-[.08em]">{c.h1}</a>)}
        {showHoodies && <a href="/hoodies/" class="shrink-0 rounded-full bg-[var(--color-paper)] border-2 border-[var(--color-ink)] px-4 py-2 text-sm font-extrabold uppercase tracking-[.08em]">Hoodies</a>}
      </div>
    </nav>

    <main id="main"><slot /></main>

    <footer class="mt-20 bg-[var(--color-ink)] text-[var(--color-paper)]">
      <div class="container-x py-12 grid gap-10 md:grid-cols-4 text-sm">
        <div>
          <p class="display text-2xl">{site.name}</p>
          <p class="mt-3 opacity-80">{site.tagline}</p>
        </div>
        <div>
          <p class="eyebrow !text-[var(--color-mustard)] mb-3">Graphic Tees</p>
          <ul class="grid gap-1.5 opacity-90">{liveTees.map((c) => <li><a href={pathFor(c)} class="hover:underline">{c.name}</a></li>)}</ul>
        </div>
        {showHoodies ? <div>
          <p class="eyebrow !text-[var(--color-mustard)] mb-3">Graphic Hoodies</p>
          <ul class="grid gap-1.5 opacity-90">
            <li><a href="/hoodies/" class="hover:underline">All hoodies</a></li>
            {liveHoodies.map((c) => <li><a href={pathFor(c)} class="hover:underline">{c.name}</a></li>)}
          </ul>
        </div> : <div />}
        <div>
          <p class="eyebrow !text-[var(--color-mustard)] mb-3">Help</p>
          <ul class="grid gap-1.5 opacity-90">
            <li><a href="/about/" class="hover:underline">About</a></li>
            <li><a href="/faq/" class="hover:underline">FAQ</a></li>
            <li><a href="/guides/" class="hover:underline">Graphic tee guides</a></li>
            <li><a href="/black-friday/" class="hover:underline">Black Friday Deals</a></li>
            <li><a href="/shipping-returns/" class="hover:underline">Shipping &amp; returns</a></li>
            <li><a href="/contact/" class="hover:underline">Contact us</a></li>
          </ul>
        </div>
      </div>
      <p class="container-x pb-8 text-xs opacity-60">© {new Date().getFullYear()} {site.name}</p>
    </footer>
    <CartDrawer />
  </body>
</html>
